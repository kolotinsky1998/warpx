################################
## USER CONSTANTS
##################################
my_constants.R = 0.005
my_constants.Nx = 72
my_constants.Nz = 72

##################################
## GEOMETRY (2D XZ; y=0)
##################################
geometry.dims = 2
geometry.prob_lo = -R -R
geometry.prob_hi =  R  R
amr.n_cell = Nx Nz
amr.max_level = 0
#
##################################
## ELECTROSTATIC SOLVER (Poisson)
##################################
warpx.do_electrostatic = labframe
#
##################################
## TIME / NUMERICS
##################################
warpx.const_dt = 0.5e-11
max_step = 2000
algo.particle_shape = 1
algo.particle_pusher = boris
warpx.grid_type = collocated
#
##################################
## BOX BOUNDARIES
##################################
boundary.field_lo = pec pec
boundary.field_hi = pec pec
boundary.particle_lo = absorbing absorbing
boundary.particle_hi = absorbing absorbing
#
##################################
### EXTERNAL FIELD
###################################
particles.B_ext_particle_init_style = constant
particles.B_external_particle = 0.0 0.05 0.0
particles.E_ext_particle_init_style = constant
particles.E_external_particle = 0.0 0.0 1000.0
#
##################################
## SPECIES
##################################
particles.species_names = electrons ions
#
## electron -> gyrokinetic
electrons.charge = -q_e
electrons.mass = m_e
electrons.particle_pusher = gyrokinetic
electrons.injection_style = SingleParticle
electrons.single_particle_pos = 0.0 0.0 0.0
electrons.single_particle_u = 0.0 0.0 0.0
electrons.single_particle_weight = 1.0
#
## ion -> boris, same mass as electron
ions.charge = q_e
ions.mass = m_e
ions.particle_pusher = boris
ions.injection_style = SingleParticle
ions.single_particle_pos = 0.0 0.0 0.0
ions.single_particle_u = 0.0 0.0 0.0
ions.single_particle_weight = 1.0
#
##################################
## DIAGNOSTICS
##################################
diagnostics.diags_names = diag_hybrid
diag_hybrid.diag_type = Full
diag_hybrid.intervals = 10
diag_hybrid.format = openpmd
diag_hybrid.write_species = 1
diag_hybrid.species = electrons ions
diag_hybrid.fields_to_plot = Ex Ez rho
diag_hybrid.electrons.variables = x z ux uz w
diag_hybrid.ions.variables = x z ux uz w

